{
  "name": "unified-ai-chat",
  "version": "1.0.0",
  "description": "One window. ChatGPT + Claude. No API keys.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:win":   "electron-builder --win",
    "build:mac":   "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.unified-ai-chat",
    "productName": "Unified AI Chat",
    "files": ["src/**/*"],
    "linux":   { "target": "AppImage" },
    "win":     { "target": "nsis" },
    "mac":     { "target": "dmg" }
  }
}
